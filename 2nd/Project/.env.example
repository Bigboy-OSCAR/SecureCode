# SecureCode server environment (task 3.2). Copy to .env and fill locally; .env is git-ignored.
# Names only: never commit values. Never prefix a secret with VITE_ (Vite exposes VITE_* to the browser).
# `npm run dev` loads .env, generates SECURECODE_INTERNAL_TOKEN per start and passes it to both servers.

# --- Model provider (server processes only; redacted from logs) ---
# Anthropic API key used by the Cline SDK host and by the context-service token counter.
ANTHROPIC_API_KEY=
# SDK providerId / modelId verified in 3.1.
SECURECODE_PROVIDER_ID=anthropic
SECURECODE_MODEL_ID=claude-sonnet-5-5
# Optional HTTPS proxy/gateway base URL (HTTP allowed only on loopback). Empty = SDK and token counter defaults.
SECURECODE_PROVIDER_BASE_URL=

# --- Budget (finalized by 4.8; body counting by context-service tokens.count) ---
# Product input limit in tokens; must not exceed the model catalog context window.
SECURECODE_MODEL_CONTEXT_LIMIT=200000
# config.maxTokensPerTurn = reserved output tokens.
SECURECODE_MAX_OUTPUT_TOKENS=8192
# Safety margin for provider_estimate counts.
SECURECODE_CONTEXT_SAFETY_MARGIN_TOKENS=2048
# Hard-cap mode: block with TOKENIZER_UNAVAILABLE when the final request cannot be counted.
SECURECODE_REQUIRE_FINAL_TOKEN_COUNT=true
# Timeout for one provider count_tokens call.
SECURECODE_TOKEN_COUNT_TIMEOUT_MS=10000

# --- SDK host (3.5) ---
# App-only SDK home; the host sets CLINE_DIR/CLINE_DATA_DIR from it before importing @cline/sdk.
# Empty = <SECURECODE_DATA_DIR>/cline.
SECURECODE_CLINE_HOME=
SECURECODE_APPROVAL_TIMEOUT_MS=300000
SECURECODE_HOOK_TIMEOUT_MS=5000
# Timeout for one approved run_command tool call.
SECURECODE_COMMAND_TIMEOUT_MS=120000
# Comma-separated absolute directories a workspace root must live under. Empty = any non-root directory.
SECURECODE_ALLOWED_WORKSPACE_ROOTS=
# One-time browser launch code. Leave empty: `npm run dev` generates one per start and prints it locally.
SECURECODE_BOOTSTRAP_CODE=

# --- Local processes (always bound to 127.0.0.1) ---
SECURECODE_HOST_PORT=8787
SECURECODE_CONTEXT_SERVICE_PORT=8788
# Vite dev server port (1.1). Its origin is allowed so the dev proxy can reach /api/v1.
SECURECODE_UI_DEV_PORT=5173
# Extra allowed browser origins, comma separated. Empty = host origin + UI dev origin only.
SECURECODE_ALLOWED_ORIGINS=
# Runtime data directory, relative to the work root. Git-ignored.
SECURECODE_DATA_DIR=.securecode
# debug | info | warn | error. Debug logging is still redacted and size-capped.
SECURECODE_LOG_LEVEL=info

# --- Live smoke (npm run test:live) ---
# Explicit opt-in because live checks call the paid provider. 1 = run, anything else = not run.
SECURECODE_LIVE_SMOKE=0
# Upper bound on provider calls made by one test:live run.
SECURECODE_LIVE_SMOKE_MAX_CALLS=10
