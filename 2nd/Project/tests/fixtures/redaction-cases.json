{
    "description": "Shared log redaction vectors (3.2). secrets lists values registered at runtime (e.g. the internal service token). max_chars is the per-message cap in code points.",
    "max_chars": 2000,
    "cases": [
        {
            "name": "key_value_api_key",
            "input": "provider failed api_key=sk-ant-api03-AbCdEf_123-xyz",
            "secrets": [],
            "expected": "provider failed api_key=[REDACTED:api_key]"
        },
        {
            "name": "bare_anthropic_key",
            "input": "using sk-ant-api03-AbCdEf_123-xyz now",
            "secrets": [],
            "expected": "using [REDACTED:api_key] now"
        },
        {
            "name": "bearer_header",
            "input": "Authorization: Bearer abcdefghijklmnop",
            "secrets": [],
            "expected": "Authorization: Bearer [REDACTED]"
        },
        {
            "name": "x_api_key_header",
            "input": "x-api-key: 0123456789abcdef",
            "secrets": [],
            "expected": "x-api-key: [REDACTED]"
        },
        {
            "name": "json_secret_field",
            "input": "{\"password\": \"hunter2hunter2\"}",
            "secrets": [],
            "expected": "{\"password\": \"[REDACTED]\"}"
        },
        {
            "name": "registered_secret",
            "input": "token mismatch for 7f3c9a1b2d4e6f80aa",
            "secrets": ["7f3c9a1b2d4e6f80aa"],
            "expected": "token mismatch for [REDACTED:secret]"
        },
        {
            "name": "windows_home_path",
            "input": "failed to read C:\\Users\\someone\\project\\app.py",
            "secrets": [],
            "expected": "failed to read <home>\\project\\app.py"
        },
        {
            "name": "posix_home_path",
            "input": "open /home/someone/work/a.py and /Users/other/b.py",
            "secrets": [],
            "expected": "open <home>/work/a.py and <home>/b.py"
        },
        {
            "name": "plain_text_unchanged",
            "input": "run run_01J9Z6Q4TEST completed in 12 ms",
            "secrets": [],
            "expected": "run run_01J9Z6Q4TEST completed in 12 ms"
        },
        {
            "name": "long_message_truncated",
            "input": "",
            "secrets": [],
            "expected": "...[truncated 5 chars]"
        }
    ]
}
