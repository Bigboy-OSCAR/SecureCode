{
    "name": "@securecode/host",
    "version": "0.0.0",
    "private": true,
    "description": "Node Cline SDK host: public /api/v1, SDK session assembly, internal context-service client.",
    "type": "module",
    "engines": {
        "node": "^22.12.0 || ^24.0.0"
    },
    "scripts": {
        "start": "tsx src/app/main.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node --import tsx --test \"tests/**/*.test.ts\"",
        "hook:test": "tsx src/pointer-hooks/example.ts",
        "sdk:probe": "tsx tools/sdk-probe.ts",
        "plugin:test": "tsx src/cline-plugins/test-runtime-pointer-plugin.ts",
        "cline:test": "tsx src/cline-plugins/test-cline-core.ts",
        "session:test": "tsx src/cline-plugins/test-session.ts",
        "pipeline:test": "tsx src/cline-plugins/test-full-pipeline.ts"
    },
    "dependencies": {
        "@cline/sdk": "0.2.0",
        "@securecode/contracts": "0.0.0"
    }
}
