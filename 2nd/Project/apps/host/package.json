{
    "name": "@securecode/host",
    "version": "0.0.0",
    "private": true,
    "description": "Node Cline SDK host: public /api/v1, SDK session assembly, internal context-service client.",
    "type": "module",
    "engines": {
        "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
    },
    "scripts": {
        "start": "tsx src/app/main.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node --import tsx --test \"tests/**/*.test.ts\"",
        "hook:test": "node --import tsx --test tests/unit/runtimePointer.test.ts",
        "sdk:probe": "npm run probe -w @securecode/sdk-probe -- --no-evidence",
        "plugin:test": "node --import tsx --test tests/integration/runtimePointerPlugin.test.ts",
        "cline:test": "npm run probe -w @securecode/sdk-probe -- --no-evidence lifecycle",
        "session:test": "npm run probe -w @securecode/sdk-probe -- --no-evidence lifecycle approval",
        "pipeline:test": "npm run hook:test && npm run plugin:test",
        "host:test": "node --import tsx --test tests/integration/sdkRuns.test.ts tests/integration/sdkSafety.test.ts tests/integration/uiApiClient.test.ts",
        "api:test": "node --import tsx --test tests/unit/hostServer.test.ts tests/unit/runLifecycle.test.ts tests/unit/devProxy.test.ts tests/unit/permissions.test.ts"
    },
    "dependencies": {
        "@cline/sdk": "0.2.0",
        "@lmstudio/sdk": "2.1.0",
        "@securecode/contracts": "0.0.0"
    }
}
