{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Pointer Read Contracts",
    "type": "object",
    "additionalProperties": false,
    "definitions": {
        "LineSelector": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "start"],
            "properties": {
                "type": {
                    "const": "line"
                },
                "start": {
                    "type": "integer",
                    "minimum": 1
                },
                "end": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "ByteSelector": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "start"],
            "properties": {
                "type": {
                    "const": "byte"
                },
                "start": {
                    "type": "integer",
                    "minimum": 0
                },
                "end": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "SectionSelector": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "section"],
            "properties": {
                "type": {
                    "const": "section"
                },
                "section": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                }
            }
        },
        "JsonPathSelector": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
                "type": {
                    "const": "json_path"
                },
                "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(?:/(?:[^~/\\x00-\\x1f\\x7f]|~[01])*)+(?![\\s\\S])"
                }
            }
        },
        "PdfPageSelector": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "start"],
            "properties": {
                "type": {
                    "const": "pdf_page"
                },
                "start": {
                    "type": "integer",
                    "minimum": 1
                },
                "end": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "PointerSelector": {
            "oneOf": [
                {
                    "$ref": "#/definitions/LineSelector"
                },
                {
                    "$ref": "#/definitions/ByteSelector"
                },
                {
                    "$ref": "#/definitions/SectionSelector"
                },
                {
                    "$ref": "#/definitions/JsonPathSelector"
                },
                {
                    "$ref": "#/definitions/PdfPageSelector"
                }
            ]
        },
        "PointerReadRequest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "pointer"],
            "properties": {
                "schema_version": {
                    "$ref": "../common/primitives.schema.json#/definitions/SchemaVersion"
                },
                "pointer": {
                    "$ref": "../common/primitives.schema.json#/definitions/PointerUri"
                },
                "selector": {
                    "$ref": "#/definitions/PointerSelector"
                },
                "max_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                },
                "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32768
                },
                "cursor": {
                    "$ref": "../common/primitives.schema.json#/definitions/OpaqueCursor"
                }
            }
        },
        "PointerReadResult": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "pointer",
                "content",
                "provenance",
                "truncated",
                "token_count",
                "count_mode"
            ],
            "properties": {
                "schema_version": {
                    "$ref": "../common/primitives.schema.json#/definitions/SchemaVersion"
                },
                "pointer": {
                    "$ref": "../common/primitives.schema.json#/definitions/PointerUri"
                },
                "content": {
                    "type": "string",
                    "maxLength": 16384,
                    "maxUtf8Bytes": 16384
                },
                "provenance": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["media_type", "byte_size", "revision"],
                    "properties": {
                        "media_type": {
                            "type": "string",
                            "minLength": 1
                        },
                        "byte_size": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "revision": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "selection": {
                            "$ref": "#/definitions/PointerSelection"
                        },
                        "display_name": {
                            "$ref": "pointer.schema.json#/definitions/PointerDisplayName"
                        },
                        "relative_path": {
                            "$ref": "../common/primitives.schema.json#/definitions/RelativePath"
                        }
                    }
                },
                "truncated": {
                    "type": "boolean"
                },
                "next_cursor": {
                    "$ref": "../common/primitives.schema.json#/definitions/OpaqueCursor"
                },
                "token_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "count_mode": {
                    "$ref": "../common/token-count.schema.json#/definitions/CountMode"
                }
            }
        },
        "PointerSelection": {
            "title": "PointerSelection",
            "type": "object",
            "additionalProperties": false,
            "required": ["revision", "content_sha256", "range"],
            "properties": {
                "revision": {
                    "type": "integer",
                    "minimum": 1
                },
                "content_sha256": {
                    "$ref": "../common/primitives.schema.json#/definitions/Sha256Hex"
                },
                "range": {
                    "oneOf": [
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["type", "start", "end"],
                            "properties": {
                                "type": {
                                    "const": "byte"
                                },
                                "start": {
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "end": {
                                    "type": "integer",
                                    "minimum": 1
                                }
                            }
                        },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["type", "page", "start", "end", "parser_version"],
                            "properties": {
                                "type": {
                                    "const": "pdf_page"
                                },
                                "page": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 500
                                },
                                "start": {
                                    "type": "integer",
                                    "minimum": 0
                                },
                                "end": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "parser_version": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 64
                                }
                            }
                        }
                    ]
                }
            }
        }
    }
}
