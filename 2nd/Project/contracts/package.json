{
    "name": "@securecode/contracts",
    "version": "0.0.0",
    "private": true,
    "description": "JSON Schema contracts (schema_version 1), fixtures, generated TypeScript types and the runtime validator.",
    "type": "module",
    "engines": {
        "node": "^22.12.0 || ^24.0.0"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "generate": "tsx scripts/generateTypes.ts",
        "generate:check": "tsx scripts/generateTypes.ts --check",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node --import tsx --test \"tests/**/*.test.ts\""
    },
    "dependencies": {
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1"
    },
    "devDependencies": {
        "json-schema-to-typescript": "16.0.0"
    }
}
